# Google Sheets database
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
# Alternative to the two service-account variables above:
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=base64_encoded_service_account_json

# Public Data Portal (data.go.kr)
PUBLIC_DATA_API_KEY=your_public_data_api_key

# Admin Secret
ADMIN_SECRET=your_admin_secret_here

# Supabase/PostgreSQL URL used only by the one-time migration script
DATABASE_URL=postgres://postgres:[PASSWORD]@[HOST]:5432/postgres

# Basic Authentication Credentials for Website Security
BASIC_AUTH_USER=your_auth_username
BASIC_AUTH_PASSWORD=your_auth_password
